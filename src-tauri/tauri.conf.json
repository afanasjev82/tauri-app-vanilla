{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app-vanilla",
  "mainBinaryName": "tauri-app-vanilla",
  "version": "0.0.0",
  "identifier": "com.tauri.vanilla.dev",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tauri-app-vanilla",
        "width": 800,
        "height": 600,
        "fullscreen": false,
        "resizable": true,
        "url": "index.html",
        "visible": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "Url explorer",
      "longDescription": "Open specified url in window",
      "args": [
        {
          "name": "url",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  }
}
